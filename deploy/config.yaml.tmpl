# CLIProxyAPI config for the models-gateway host (single client: models-gateway).
# Rendered to /var/lib/cliproxy/config.yaml by /usr/local/sbin/cliproxy-render-config.
# __CLIENT_KEY__ and __CLAUDE_TOKEN__ are filled in on the host; never commit real values.
config-version: 8

server:
  # Private network only, next to agent-cli-to-api (10.0.0.3:8000).
  host: "10.0.0.3"
  port: 8317
  trusted-proxies: []
  tls:
    enable: false
  discovery:
    enabled: false

management:
  # The Management API and dashboard are enabled by MANAGEMENT_PASSWORD in
  # /etc/cliproxyapi/management.env (see cliproxyapi.service). That password also allows
  # private-network access, which an SSH tunnel to 10.0.0.3 needs. Leave secret-key empty.
  allow-remote: false
  secret-key: ""
  # Dashboard at /management.html, downloaded once from panel-github-repository.
  disable-control-panel: false
  disable-auto-update-panel: true

access:
  api-keys:
    - "__CLIENT_KEY__"

routing:
  strategy: "round-robin"
  session-affinity: false
  force-model-prefix: false
  retry:
    request-retry: 3
    max-retry-credentials: 0
    max-retry-interval: 30

requests:
  proxy-url: ""
  passthrough-headers: false
  streaming:
    keepalive-seconds: 15
    bootstrap-retries: 1

# Claude subscription: the same `claude setup-token` (sk-ant-oat...) that agent-cli-to-api uses.
# sk-ant-oat tokens are sent as Claude Code OAuth credentials.
api-keys:
  claude:
    - name: claude-subscription
      keys:
        - api-key: "__CLAUDE_TOKEN__"

# Codex: OAuth file created by `cli-proxy-api -codex-device-login` in auth-dir.
# Antigravity: OAuth file created by `cli-proxy-api -antigravity-login` in auth-dir.
oauth:
  auth-dir: "/var/lib/cliproxy/auths"
  # Antigravity also offers Claude models. Rename them so a bare Claude name only ever
  # reaches the Claude subscription (one model name, one provider).
  model-alias:
    antigravity:
      - name: "claude-sonnet-4-6"
        alias: "agy:claude-sonnet-4-6"
        force-mapping: true
      - name: "claude-opus-4-6-thinking"
        alias: "agy:claude-opus-4-6-thinking"
        force-mapping: true
  # xAI (Grok): OAuth file created by `cli-proxy-api -xai-login` in auth-dir.
  providers:
    xai:
      # Web search stays opt-in: never add x_search unless the client sends it.
      inject-x-search: false

multimedia:
  # Only use image_generation when the client sends it; never inject it.
  disable-image-generation: "passthrough"

observability:
  logs:
    debug: false
    logging-to-file: false
    request-log: false
  usage:
    usage-statistics-enabled: false
  pprof:
    enable: false

plugins:
  enabled: false
