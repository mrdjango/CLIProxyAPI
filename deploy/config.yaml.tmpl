# CLIProxyAPI config for the models-gateway host (single client: models-gateway).
# Rendered to /var/lib/cliproxy/config.yaml by /usr/local/sbin/cliproxy-render-config.
# __CLIENT_KEY__ and __CLAUDE_TOKEN__ are filled in on the host; never commit real values.
config-version: 8

server:
  # Private network only, next to agent-cli-to-api (10.0.0.3:8000).
  host: "10.0.0.3"
  port: 8317
  trusted-proxies: []
  tls:
    enable: false
  discovery:
    enabled: false

management:
  # The Management API and dashboard are enabled by MANAGEMENT_PASSWORD in
  # /etc/cliproxyapi/management.env (see cliproxyapi.service). That password also allows
  # private-network access, which an SSH tunnel to 10.0.0.3 needs. Leave secret-key empty.
  allow-remote: false
  secret-key: ""
  # Dashboard at /management.html, downloaded once from panel-github-repository.
  disable-control-panel: false
  disable-auto-update-panel: true

access:
  api-keys:
    - "__CLIENT_KEY__"

routing:
  strategy: "round-robin"
  session-affinity: false
  force-model-prefix: false
  retry:
    request-retry: 3
    max-retry-credentials: 0
    max-retry-interval: 30

requests:
  proxy-url: ""
  passthrough-headers: false
  streaming:
    keepalive-seconds: 15
    bootstrap-retries: 1

# Claude subscription: the same `claude setup-token` (sk-ant-oat...) that agent-cli-to-api uses.
# sk-ant-oat tokens are sent as Claude Code OAuth credentials.
api-keys:
  claude:
    - name: claude-subscription
      keys:
        - api-key: "__CLAUDE_TOKEN__"

# Codex: OAuth file created by `cli-proxy-api -codex-device-login` in auth-dir.
# Antigravity: OAuth file created by `cli-proxy-api -antigravity-login` in auth-dir.
oauth:
  auth-dir: "/var/lib/cliproxy/auths"
  # Antigravity also offers Claude models. Rename them so a bare Claude name only ever
  # reaches the Claude subscription (one model name, one provider).
  model-alias:
    antigravity:
      - name: "claude-sonnet-4-6"
        alias: "agy:claude-sonnet-4-6"
        force-mapping: true
      - name: "claude-opus-4-6-thinking"
        alias: "agy:claude-opus-4-6-thinking"
        force-mapping: true
      - name: "claude-sonnet-5-5-high"
        alias: "agy:claude-sonnet-5-5-high"
        force-mapping: true
      - name: "claude-opus-5-5-high"
        alias: "agy:claude-opus-5-5-high"
        force-mapping: true
    # The model catalog only lists these Claude models under their dated IDs. Also expose
    # the undated names clients send (fork keeps the dated IDs). Global aliases skip
    # api-keys groups, so these route through the Claude OAuth login in auth-dir.
    claude:
      - name: "claude-haiku-4-5-20251001"
        alias: "claude-haiku-4-5"
        fork: true
        force-mapping: true
      - name: "claude-sonnet-4-5-20250929"
        alias: "claude-sonnet-4-5"
        fork: true
        force-mapping: true
      - name: "claude-opus-4-5-20251101"
        alias: "claude-opus-4-5"
        fork: true
        force-mapping: true
  # Hide models the accounts cannot use, so /v1/models lists only models that answer
  # (checked 2026-11-02; Devin list extended 2026-11-09). Kimi: the subscription has no
  # Kimi Code access, so every model returns 403. Devin: only devin/swe-1-6-slow works; the rest return 403 "no longer
  # available for your account" (devin/swe-1-7 returns an upstream internal error).
  # Remove an entry once the account can use that model again.
  excluded-models:
    kimi-ai:
      - "*"
    devin:
      - "devin/claude-5-fable"
      - "devin/claude-fable-5-1"
      - "devin/claude-haiku-5-5"
      - "devin/claude-opus-4-6"
      - "devin/claude-opus-4-6-1m"
      - "devin/claude-opus-4-7"
      - "devin/claude-opus-4-8"
      - "devin/claude-opus-5"
      - "devin/claude-opus-5-5"
      - "devin/claude-sonnet-4-6"
      - "devin/claude-sonnet-4-6-1m"
      - "devin/claude-sonnet-5"
      - "devin/claude-sonnet-5-5"
      - "devin/deepseek-v4-1-flash-1017"
      - "devin/deepseek-v4-flash"
      - "devin/deepseek-v4-pro"
      - "devin/gemini-3-5-flash"
      - "devin/gemini-3-6-flash"
      - "devin/gemini-3-7-flash"
      - "devin/gemini-3-8-flash"
      - "devin/gemini-4-argon"
      - "devin/glm-5-2"
      - "devin/glm-5-2-1m"
      - "devin/glm-5-3"
      - "devin/glm-5-3-flash"
      - "devin/gpt-5-4"
      - "devin/gpt-5-4-mini"
      - "devin/gpt-5-5"
      - "devin/gpt-5-6-luna"
      - "devin/gpt-5-6-sol"
      - "devin/gpt-5-6-terra"
      - "devin/gpt-6-1-sol"
      - "devin/gpt-6-1-terra"
      - "devin/gpt-6-astra"
      - "devin/gpt-6-luna"
      - "devin/gpt-6-sol"
      - "devin/grok-4-6"
      - "devin/grok-4-7"
      - "devin/kimi-k2-6"
      - "devin/kimi-k2-7"
      - "devin/kimi-k3"
      - "devin/muse-wonder-1-0"
      - "devin/nemotron-3-5-super"
      - "devin/nemotron-3-ultra"
      - "devin/swe-1-6"
      - "devin/swe-1-7"
      - "devin/swe-2"
      - "devin/swe-2-flash"
      - "devin/swe-2-lightning"
    # Codex lists it, but the ChatGPT account cannot use it (400 "not supported when using
    # Codex with a ChatGPT account", checked 2026-11-09).
    codex:
      - "gpt-6-chat-thinking"
  # xAI (Grok): OAuth file created by `cli-proxy-api -xai-login` in auth-dir.
  providers:
    xai:
      # Web search stays opt-in: never add x_search unless the client sends it.
      inject-x-search: false

multimedia:
  # Only use image_generation when the client sends it; never inject it.
  disable-image-generation: "passthrough"

observability:
  logs:
    debug: false
    logging-to-file: false
    request-log: false
  usage:
    usage-statistics-enabled: false
  pprof:
    enable: false

plugins:
  enabled: false
